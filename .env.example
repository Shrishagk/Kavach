# Copy to .env and fill in. NEVER commit .env.
SARVAM_API_KEY=
# true = fake AI responses, no key/credits needed (for frontend work and tests)
MOCK_MODE=false
ENV=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: protects GET /api/v1/admin/metrics
ADMIN_TOKEN=

# Models (change here if Sarvam renames them)
STT_MODEL=saaras:v4
LLM_MODEL=sarvam-105b
LLM_REASONING_EFFORT=low
TTS_MODEL=bulbul:v4-flash
TTS_FALLBACK_MODEL=bulbul:v3
TRANSLATE_MODEL=sarvam-translate:v1
# auto = Document AI first, image LLM if it fails | doc_ai | llm
VISION_MODE=auto
VISION_LLM_MODEL=gemma4

# Limits
SESSION_TTL_HOURS=24
MAX_AUDIO_SECONDS=300
RATE_LIMIT_PER_MINUTE=40
